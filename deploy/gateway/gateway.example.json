{
  "databasePath": "/var/lib/open-push-channel/gateway.sqlite",
  "runtimes": [
    { "id": "openclaw", "type": "openclaw", "url": "http://host.docker.internal:3002/webhook" }
  ],
  "auth": {
    "clients": [
      {
        "id": "demo",
        "tokenEnv": "PUSH_GATEWAY_CLIENT_TOKEN",
        "targets": [{ "runtimeId": "openclaw", "agentId": "main" }]
      }
    ],
    "pushTokenEnv": "PUSH_CHANNEL_PUSH_TOKEN"
  }
}
