{
  "name": "open-push-channel",
  "version": "0.1.0",
  "description": "Connect OpenClaw, DeepSeek Harness, and Pi to web apps through a shared gateway protocol.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiehaojie/open-push-channel.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./dsh": "./plugins/dsh/index.mjs"
  },
  "files": [
    "dist/**/*.js",
    "index.ts",
    "openclaw.plugin.json",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "plugins/client.cjs",
    "plugins/dsh/index.mjs",
    "protocol/*.cjs",
    "protocol/*.d.cts",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test admin-backend/src/**/*.test.js frontend-demo/*.test.js plugins/client.test.cjs plugins/dsh/index.test.cjs deploy/runtime-runner/bootstrap.test.cjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.20"
    },
    "build": {
      "openclawVersion": "2026.5.20"
    },
    "channel": {
      "id": "push-channel",
      "label": "Open Push Channel",
      "selectionLabel": "Open Push Channel",
      "docsPath": "https://github.com/xiehaojie/open-push-channel#readme",
      "docsLabel": "open-push-channel",
      "blurb": "Connect OpenClaw to your web app through the Open Push Channel gateway."
    }
  }
}
