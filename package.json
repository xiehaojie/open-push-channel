{
  "name": "open-push-channel",
  "version": "0.2.0",
  "description": "Connect OpenClaw, DeepSeek Harness, and Pi to web apps through a shared gateway protocol.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiehaojie/open-push-channel.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./dsh": "./dist/plugins/dsh/index.mjs"
  },
  "files": [
    "dist/**/*.js",
    "dist/plugins/dsh/index.mjs",
    "index.ts",
    "openclaw.plugin.json",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/build.ts && npm run build:demo",
    "build:demo": "node frontend-demo/build.ts",
    "prepack": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.standalone.json",
    "pretest": "npm run build:demo",
    "test": "node --test \"admin-backend/src/**/*.test.cts\" \"frontend-demo/*.test.ts\" \"plugins/**/*.test.cts\" \"deploy/runtime-runner/*.test.cts\""
  },
  "devDependencies": {
    "@types/koa": "3.0.3",
    "@types/koa__cors": "5.0.1",
    "@types/koa-bodyparser": "4.3.13",
    "@types/node": "22.20.5",
    "@types/node-fetch": "2.6.13",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.20"
    },
    "build": {
      "openclawVersion": "2026.5.20"
    },
    "channel": {
      "id": "push-channel",
      "label": "Open Push Channel",
      "selectionLabel": "Open Push Channel",
      "docsPath": "https://github.com/xiehaojie/open-push-channel#readme",
      "docsLabel": "open-push-channel",
      "blurb": "Connect OpenClaw to your web app through the Open Push Channel gateway."
    }
  }
}
